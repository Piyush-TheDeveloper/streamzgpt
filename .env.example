# Copy to .env.local and fill in. Never commit real keys.

# TMDB (https://www.themoviedb.org/settings/api) — "API Read Access Token".
# LOCAL DEVELOPMENT ONLY: VITE_* vars are bundled into the client. In production
# leave this unset; the `tmdb` Appwrite Function holds the token server-side.
VITE_TMDB_TOKEN=

# Appwrite (public identifiers, not secrets)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=66cefed6001a7ff199d6
